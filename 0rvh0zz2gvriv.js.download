removed or unpublished.","backToList":"All How-To Guides","lastUpdated":"Last updated","language":"Language"},"support":{"title":"Support","subtitle":"Open a ticket and the Storzu team will reply by email — usually within one business day.","newTicket":"New ticket","ticketCreated":"Ticket {{number}} created. We\'ll email you back at the address on your account.","categoryLabel":"Category","catApp":"Mobile or web app issue","catOrders":"Orders / fulfilment / tracking","catProducts":"Products / catalog / images","catBilling":"Billing / plans / payments","catShipping":"Shipping / courier / delivery","catAccount":"Account / login / OTP","catOther":"Something else","subjectLabel":"Subject","subjectPlaceholder":"Short summary, e.g. \'Customer didn\'t get tracking SMS\'","descriptionLabel":"What happened?","descriptionPlaceholder":"Tell us as much as you can — order numbers, error messages, what you expected vs. what happened.","attachmentsLabel":"Screenshots (optional, max {{max}} · 5 MB each)","attachmentTooBig":"\\"{{name}}\\" is larger than 5 MB. Please pick a smaller image.","uploadFailed":"Upload failed.","addAttachment":"+ Add","sendTicket":"Send ticket","errSubjectShort":"Subject must be at least 4 characters.","errMessageShort":"Please describe the issue in at least 10 characters.","errCreateTicket":"Could not create the ticket.","errNetwork":"Network error — try again.","yourTickets":"Your tickets","loadingShort":"Loading…","noTicketsYet":"You haven\'t opened any support tickets yet.","noRepliesYet":"No replies yet — we\'ll email you when support responds.","statusOpen":"Open","statusInProgress":"In progress","statusWaitingVendor":"Waiting on you","statusResolved":"Resolved","statusClosed":"Closed","fromSupport":"Storzu Support","fromYou":"You"},"feedback":{"title":"Feedback","subtitle":"Share what could be better — we read every message.","technicalIssueCallout":"Have a <strong>technical issue</strong>? Open a support ticket instead — feedback is for ideas and improvements.","tabFeedback":"Share feedback","tabSurvey":"Quick survey","badgeNew":"New","thanks":"Thanks for your feedback!","thanksMsg":"The Storzu team will review it soon.","sendAnother":"Send another","sendingAs":"Sending as <strong>{{name}}</strong> · {{phone}}","storeLabel":"Store","typeLabel":"Type","typeImprovement":"Improvement","typeFeatureRequest":"Feature request","typeGeneral":"General","areaLabel":"Area","areaChoose":"Choose area (optional)","areaProducts":"Products","areaCategories":"Categories","areaAi":"AI features","areaPricing":"Pricing","areaOrders":"Orders","areaDashboard":"Dashboard","areaOther":"Other","messageLabel":"Your message","messagePlaceholder":"What could be better? What feature would help?","screenshotsLabel":"Screenshots (optional, max 3)","add":"Add","sendFeedback":"Send feedback","submitSurvey":"Submit survey","submittingSurvey":"Submitting…","noActiveSurvey":"No active survey right now. Check back soon!","surveyDone":"You\'re all set","surveyDoneMsg":"Thanks for completing the survey.","anythingElse":"Anything else? (optional)","errMessageShort":"Please write a bit more (5+ characters)","errSubmit":"Failed to submit"},"updates":{"title":"A word from Storzu","subtitle":"Updates, tips, and announcements from the team","empty":"No updates yet. Check back soon.","pinned":"Pinned","badgeNew":"New"},"verifyEmail":{"title":"Verify your email","sending":"Sending a 6-digit code to {{email}}...","sent":"We sent a 6-digit code to {{email}}","yourEmail":"your email","resendIn":"Resend in","resendCode":"Resend code","useDifferentEmail":"Use a different email","emailPlaceholder":"you@example.com","sendFreshCodeNote":"We\'ll send a fresh code to the new address.","wrongEmail":"Wrong email?","changeEmail":"Change email","errInvalidCode":"Invalid code","errSendCode":"Failed to send code","errSomethingWrong":"Something went wrong","errCantUpdate":"Couldn\'t update email","fallbackName":"there"},"emailVerifyBanner":{"title":"Verify your email","optionalSuffix":"— optional, but recommended","body":"Enables password recovery and order email notifications. You can keep using the dashboard either way.","verifyNow":"Verify now","later":"Later"},"trialBanner":{"expiredTitle":"Your 90-day Starter trial has ended","expiredBodyPrefix":"Upgrade to keep all your products visible and your custom storefront live. Right now only ","expired100Products":"100 products","expiredBodySuffix":" show on your store and the default template is in use — your data is safe.","needHelpUpgrading":"Need help upgrading?","needHelpOrUpgrade":"Need help or want to upgrade?","upgradeNow":"Upgrade now","seePlans":"See plans","later":"Later","activeTitle":"🎉 You\'re on a 90-day Starter trial — Day {{dayN}} of {{total}}","warningTitleSingular":"Your Starter trial ends in {{days}} day","warningTitlePlural":"Your Starter trial ends in {{days}} days","endingTitleSingular":"⏰ Only {{days}} day left on your Starter trial","endingTitlePlural":"⏰ Only {{days}} days left on your Starter trial","activeBody":"All Starter features are unlocked — premium storefront templates, up to 300 products across unlimited categories, multi-pack variants, and more.","endingBody":"After your trial ends, only 100 products stay visible and your custom template falls back to default. Nothing is deleted — upgrade to keep them live."},"storzuTicker":{"label":"A word from Storzu","new":"New"},"liveStore":{"viewLiveStore":"View your live store","live":"Live","ariaViewStorefront":"View your live storefront","ariaShowLink":"Show live store link","ariaHideLink":"Hide live store link","hide":"Hide"},"openStore":{"title":"Opening your storefront in a new tab","body":"You\'ll see your store exactly the way customers see it. Your dashboard stays right here in this tab — switch back any time to keep editing.","proTip":"Pro tip — avoid seeing old designs","proTipBodyPrefix":"Applied a new theme or made visual changes? ","proTipBodyBold":"Refresh the storefront tab or open it in incognito mode","proTipBodySuffix":" — browsers often cache the old design and won\'t show your latest updates automatically.","openMyStore":"Open my store"},"welcomeModal":{"kindWelcome":"Welcome to Storzu","kindFeature":"What\'s new","kindMaintenance":"Maintenance heads-up","fallbackName":"there","fallbackShop":"your store","fallbackUrl":"your live store URL","watch":"Watch","nVideos":"{{count}} videos","playVideo":"Play video","whatDidYouThink":"What did you think?","like":"Like","dislike":"Dislike","commentLabel":"Comment (optional, max {{max}} words)","commentPlaceholder":"Tell us what stood out, or what you\'d like to see…","wordCountTrim":"{{count}}/{{max}} words — please trim","wordCount":"{{count}}/{{max}} words","saving":"Saving…","okGotIt":"OK, got it"},"bulkCard":{"statusQueued":"Queued","statusCompressing":"Compressing...","statusUploading":"Uploading...","statusAnalyzing":"AI Analyzing...","statusReady":"Ready","statusError":"Error","statusFlagged":"Flagged","altProduct":"Product","categoryMismatch":"Category mismatch","flaggedDefault":"Content flagged by AI moderation","pattern":"Pattern","type":"Type","style":"Style","editAiDetails":"Edit AI details","descriptionLabel":"Description","descriptionPlaceholder":"AI-generated description","colorsLabel":"Colors (comma separated)","colorsPlaceholder":"Red, Gold, Green","designPatternLabel":"Design Pattern","designPatternPlaceholder":"e.g., Temple Motifs, Floral","sareeType":"Saree Type","border":"Border","zari":"Zari","pallu":"Pallu","jewelleryType":"Jewellery Type","jewelleryTypePlaceholder":"e.g., Necklace","designStyle":"Design Style","designStylePlaceholder":"e.g., Temple, Kundan","occasion":"Occasion","occasionPlaceholder":"e.g., Wedding, Festive","collapse":"Collapse"},"bulkUpload":{"title":"Bulk Upload","subtitle":"Upload multiple product photos — AI writes descriptions, detects colors & patterns","backToProducts":"Back to Products","howItWorks":"How Bulk Upload Works","youProvide":"You provide:","youProvi